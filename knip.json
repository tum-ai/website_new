{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Loaded by the Sanity CLI from `src/sanity` by `pnpm sanity:typegen`,
  // where knip can't follow the path. (`pnpm sanity:backfill` runs
  // scripts/sanity/backfill.ts through tsx, which knip finds in package.json
  // by itself.)
  // scripts/sanity/repair-assets.ts, apply-partner-migration.ts,
  // migrate-content-dedup-apply.ts, migrate-org-references-apply.ts and
  // migrate-home-quotes-apply.ts: run by path through `sanity exec` from
  // backfill.ts, migrate-partners.ts, migrate-content-dedup.ts,
  // migrate-org-references.ts and migrate-home-quotes.ts.
  "entry": [
    "test/stubs/*.ts",
    "src/sanity/sanity.cli.ts",
    "scripts/sanity/repair-assets.ts",
    "scripts/sanity/apply-partner-migration.ts",
    "scripts/sanity/migrate-content-dedup-apply.ts",
    "scripts/sanity/migrate-org-references-apply.ts",
    "scripts/sanity/migrate-home-quotes-apply.ts"
  ],
  // Loaded by path: playwright.config.ts `toHaveScreenshot.stylePath`.
  "ignoreFiles": ["e2e/visual-screenshot.css"],
  "ignoreIssues": {
    // Generated by Sanity TypeGen (`pnpm sanity:typegen`): it exports every
    // schema type, used or not.
    "src/lib/sanity.types.generated.ts": ["exports", "types"]
  },
  "ignoreDependencies": [
    // Open question for Justin (cleanup #264 checklist, "Ops"): keep the
    // Vercel CLI as a devDependency (`pnpm exec vercel env pull`,
    // docs/contributor-guide.md) or drop it.
    "vercel"
  ]
}
