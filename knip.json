{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `sanity.cli.ts` is loaded by the Sanity CLI (`pnpm sanity:typegen`).
  "entry": ["test/stubs/*.ts", "src/sanity/sanity.cli.ts"],
  // Loaded by path: playwright.config.ts `toHaveScreenshot.stylePath`.
  "ignoreFiles": ["e2e/visual-screenshot.css"],
  "ignoreIssues": {
    // Generated by Sanity TypeGen (`pnpm sanity:typegen`): it exports every
    // schema type, used or not.
    "src/lib/sanity.types.generated.ts": ["exports", "types"],
    // The design system's prop and variant types are its public API for
    // typing wrappers, like the components' own props. Runtime exports are
    // still checked (and the showcase must use each one, see
    // showcase-coverage.test.ts).
    "src/components/ds/**": ["types"]
  },
  "ignoreDependencies": [
    // Runs the git hooks from lefthook.yml; installed by `pnpm install`.
    "lefthook",
    // Open question for Justin (cleanup #264 checklist, "Ops"): keep the
    // Vercel CLI as a devDependency (`pnpm exec vercel env pull`,
    // docs/contributor-guide.md) or drop it.
    "vercel",
    // Unused since the redesign. Either type the JSON-LD in config/seo.ts
    // with it or remove it; tracked as a W3-Lock handoff.
    "schema-dts"
  ]
}
