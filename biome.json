{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/tsconfig*.json", "!public/**/*.svg"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "correctness": {
        "usePlaywrightValidDescribeCallback": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@/components/ds",
                  "@/components/ds/**",
                  "@tum.ai/ui-kit/dist/**",
                  "@tum.ai/ui-kit/src/**"
                ],
                "message": "Use the published @tum.ai/ui-kit entry points, not copied components or package internals."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["knip.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features",
                      "@/features/**",
                      "@/components",
                      "@/components/**",
                      "@/config",
                      "@/config/**"
                    ],
                    "message": "`lib` is the bottom layer: it may not import features, components or config."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features",
                      "@/features/**",
                      "@/components",
                      "@/components/**"
                    ],
                    "message": "`config` may import only `lib`, not features or components."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "markdown": { "formatter": { "enabled": false } },
  "tailwind": {
    "stylesheet": "./src/styles/index.css",
    "mergeFunctions": ["cn"],
    "variantFunctions": ["cva"]
  }
}
