# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set per environment (Production / Preview / Development).

# --- Sanity (public; inlined into the browser bundle) -----------------------
# Required editable page content fails visibly without a project ID and an
# explicit page-content dataset. For credential-free local work, select the
# build-time USE_MOCK_CMS gate below.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# The one dataset the site and Studio read. Explicitly select `redesign` for
# the new site's page content. The legacy shared config defaults to production
# when unset, but page-content readers reject unset/production configuration.
# Production belongs to the old site and is never a migration target.
NEXT_PUBLIC_SANITY_DATASET=

# --- Sanity (server only; never sent to the browser) ------------------------
# Viewer-scoped read token. Enables draft mode from the Studio's Presentation
# tool (/api/draft-mode/enable) and fetches drafts while it is on. Unset:
# /api/draft-mode/enable answers 503 and pages show published content only.
SANITY_API_READ_TOKEN=

# Optional, SEPARATE Viewer-scoped token that <SanityLive> hands to the
# BROWSER for live draft updates outside the Presentation tool. It is visible
# to anyone in a draft-mode session, so never reuse SANITY_API_READ_TOKEN here.
# Unset (the default): no token reaches the browser.
SANITY_API_BROWSER_TOKEN=

# Shared secret of the Sanity GROQ webhook that calls /api/revalidate (on the
# site's dataset, set in sanity.io/manage, API, Webhooks). The route checks each
# request's signature with it and expires the changed type's cache tags, so
# CMS edits show on the next request instead of at the next deploy. Unset:
# /api/revalidate answers 503 and pages refresh on their `revalidate` timer
# or at the next deploy. Generate a long random value (openssl rand -hex 32).
SANITY_REVALIDATE_SECRET=

# --- Local mock CMS (development and E2E only; ignored on Vercel) -----------
# 1 selects synthetic CMS documents in src/lib/cms-fixtures/ plus event/research
# fixtures in src/lib/mock-cms.ts. The literal gate also requires !VERCEL.
# Read at BUILD time: next.config.ts inlines it (compiler.defineServer), so
# set it for `pnpm build` / `pnpm dev`, not only for `pnpm start`. A build
# without it contains no mock-CMS code at all.
USE_MOCK_CMS=

# Fixed "now" for local mock data and render clocks. CI Build/perf and
# Playwright use 2026-10-01T12:00:00Z for stable time-dependent views.
# ISO 8601 date (2026-09-25) or date-time with an offset (2026-09-25T12:00:00Z).
# Read when a page renders, which for prerendered pages is during the build.
# Unset: the real clock.
MOCK_CMS_NOW=
