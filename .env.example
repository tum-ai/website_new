# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set per environment (Production / Preview / Development).

# --- Sanity (public; inlined into the browser bundle) -----------------------
# Without a project ID the CMS-backed pages (/events, /research, /partners)
# render their empty states and make no requests.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# The live dataset: events, partners and research (default: production). The
# old site on `main` renders this dataset too; never import content types here.
NEXT_PUBLIC_SANITY_DATASET=
# The content dataset: FAQs, campaigns, logos and page copy moving out of code
# (docs/adr/0009-cms-content-source.md), edited in /studio/content. Planned
# value: redesign. No default: unset (or set to the live dataset), the Studio
# has no content workspace and CMS_CONTENT_SOURCE=sanity renders the code
# content (logged once). Page content never goes to the live dataset.
NEXT_PUBLIC_SANITY_CONTENT_DATASET=

# --- CMS content source (server only) ---------------------------------------
# code (default): pages render the content in the repository, exactly as
# before; no request to the content dataset.
# sanity: pages read the content dataset and lay it over the code content, so
# an empty or missing field falls back to code. Read at render time (with
# static pages: at build or revalidation). Any other value fails the build.
# With USE_MOCK_CMS=1, `sanity` serves the backfill documents locally.
CMS_CONTENT_SOURCE=

# --- Sanity (server only; never sent to the browser) ------------------------
# Viewer-scoped read token. Enables draft mode from the Studio's Presentation
# tool (/api/draft-mode/enable) and fetches drafts while it is on. Unset:
# /api/draft-mode/enable answers 503 and pages show published content only.
SANITY_API_READ_TOKEN=

# Optional, SEPARATE Viewer-scoped token that <SanityLive> hands to the
# BROWSER for live draft updates outside the Presentation tool. It is visible
# to anyone in a draft-mode session, so never reuse SANITY_API_READ_TOKEN here.
# Unset (the default): no token reaches the browser.
SANITY_API_BROWSER_TOKEN=

# Shared secret of the Sanity GROQ webhooks that call /api/revalidate (one per
# dataset, set in sanity.io/manage, API, Webhooks). The route checks each
# request's signature with it and expires the changed type's cache tags, so
# CMS edits show on the next request instead of at the next deploy. Unset:
# /api/revalidate answers 503 and pages refresh on their `revalidate` timer
# or at the next deploy. Generate a long random value (openssl rand -hex 32).
SANITY_REVALIDATE_SECRET=

# --- Local mock CMS (development and E2E only; ignored on Vercel) -----------
# 1 serves fixtures from src/lib/mock-cms.ts instead of Sanity.
# Read at BUILD time: next.config.ts inlines it (compiler.defineServer), so
# set it for `pnpm build` / `pnpm dev`, not only for `pnpm start`. A build
# without it contains no mock-CMS code at all.
USE_MOCK_CMS=

# Fixed "now" the mock events are dated from, for stable E2E and visual tests.
# ISO 8601 date (2026-09-25) or date-time with an offset (2026-09-25T12:00:00Z).
# Read when a page renders, which for prerendered pages is during the build.
# Unset: the real clock.
MOCK_CMS_NOW=
