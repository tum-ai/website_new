{
  "name": "@tumai/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "node scripts/run-next-command.mjs build .next-prod",
    "start": "node scripts/run-next-command.mjs start .next-prod",
    "lint": "biome check --error-on-warnings .",
    "lint:apply": "biome check . --write",
    "format": "biome format .",
    "typecheck": "node scripts/run-next-command.mjs typegen .next-prod && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:visual": "E2E_VISUAL=1 playwright test",
    "knip": "knip",
    "sanity:typegen": "cd src/sanity && DO_NOT_TRACK=1 NEXT_PUBLIC_SANITY_DATASET=schema-extract sanity schemas extract --enforce-required-fields --force --path ../../node_modules/.cache/sanity/schema.json && DO_NOT_TRACK=1 sanity typegen generate && cd ../.. && biome format --write src/lib/sanity.types.generated.ts",
    "sanity:typegen:check": "pnpm sanity:typegen && git diff --exit-code -- src/lib/sanity.types.generated.ts",
    "sanity:backfill": "tsx --tsconfig scripts/sanity/tsconfig.json scripts/sanity/backfill.ts",
    "sanity:migrate-partners": "tsx --tsconfig scripts/sanity/tsconfig.json scripts/sanity/migrate-partners.ts",
    "sanity:migrate-content-dedup": "tsx --tsconfig scripts/sanity/tsconfig.json scripts/sanity/migrate-content-dedup.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:perf"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@calcom/embed-react": "^1.5.3",
    "@date-fns/tz": "^1.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "axe-core": "^4.13.0",
    "groq-js": "^2.0.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "schema-dts": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vercel": "^59.1.3",
    "vite": "^8.1.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "@vercel/node>undici": "^6.28.1",
      "vercel>undici": "^6.28.1",
      "tar@<7.5.21": "^7.5.22",
      "undici@>=6.0.0 <6.28.1": "^6.28.1",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "adm-zip@>=0.6.0 <0.6.1": "^0.6.1"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
